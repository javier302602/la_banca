# =====================================================================================================
# La Banca — variables de entorno
#
# Copia este archivo a .env y completa los valores:   cp .env.example .env
# Lo usan docker compose (docs/DESPLIEGUE.md), uvicorn en local (--env-file .env) o Vercel (panel).
# Nada sensible va en el código: todo lo configurable está aquí. Nunca subas tu .env al repositorio.
#
# Los valores de abajo sirven tal cual para el perfil «dev» de docker compose, salvo las CLAVES, que debes
# cambiar. Para «prod» cambia también lo marcado con [PROD].
# =====================================================================================================

# --- Perfil de docker compose -------------------------------------------------------------------------
# dev  → Mailpit para los correos y certificado local en https://localhost:8443
# prod → dominio real con Let's Encrypt y SMTP real                                           [PROD] prod
# Agrega «,tunel» para Cloudflare Tunnel (ver CLOUDFLARE_TUNNEL_TOKEN).
COMPOSE_PROFILES=dev

# --- Entorno de la app: desarrollo | produccion | pruebas -------------------------------------------
# Con produccion la app NO arranca si falta algo de lo siguiente: IMAGE_STORAGE=s3, EMAIL_SENDER=smtp
# (con SMTP_TLS cifrado), TERMINOS_VERSION, TERMINOS_FECHA y CANAL_ARCO. Además redirige HTTP→HTTPS y envía HSTS.
# «pruebas» habilita el reloj de pruebas (RNF-MAN-02); no lo uses con datos reales.
# [PROD] produccion
ENTORNO=desarrollo

# --- Proxy (Caddy) y dirección pública ----------------------------------------------------------------
# SITIO: nombre con el que se entra. localhost → certificado local (el navegador avisa una vez).
#        Un dominio real (con su DNS apuntando a este servidor) → certificado de Let's Encrypt.
# [PROD] banca.unas.edu.pe
SITIO=localhost
# Puertos publicados por Caddy. En prod deben ser 80 y 443 (Let's Encrypt los necesita).
# [PROD] 80
PUERTO_HTTP=8080
# [PROD] 443
PUERTO_HTTPS=8443
# Correo para avisos de Let's Encrypt (vencimiento de certificados).
# [PROD] ti@unas.edu.pe
# ACME_EMAIL=
# URL pública: se usa en los enlaces de activación y recuperación de los correos. Sin barra final.
# [PROD] https://banca.unas.edu.pe
APP_BASE_URL=https://localhost:8443
# Cookie de sesión solo por HTTPS (true siempre detrás de Caddy; false solo para http://localhost sin proxy).
COOKIE_SECURE=true

# --- App (gunicorn) -----------------------------------------------------------------------------------
# Procesos de trabajo. Regla práctica: 2 × núcleos. Con ENTORNO=pruebas usa 1 (el reloj vive en memoria).
WEB_WORKERS=2
WEB_TIMEOUT=60
NIVEL_LOG=info

# --- Base de datos ------------------------------------------------------------------------------------
# En docker compose no hace falta tocarla: el servicio «mongo» es un replica set (las transacciones lo exigen).
# Para MongoDB Atlas o un replica set externo, descomenta y ajusta:
# MONGO_URI=mongodb+srv://usuario:clave@cluster.mongodb.net/?retryWrites=true
# Para uvicorn en local contra un Mongo propio: mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGO_DB=la_banca_db

# --- Almacenamiento de archivos (imágenes, fotos de perfil y documentos) -----------------------------
# En docker compose siempre es s3 contra el MinIO del propio compose (IMAGE_STORAGE y STORAGE_ENDPOINT se fijan
# allí). Las claves son también el usuario y la contraseña de administración de MinIO: usa solo letras y dígitos
# (van dentro de una URL) y al menos 8 caracteres en la clave secreta.
STORAGE_BUCKET=la-banca
# CAMBIAR
STORAGE_ACCESS_KEY=banca
# CAMBIAR
STORAGE_SECRET_KEY=CambiaEstaClave123
STORAGE_REGION=us-east-1
# Fuera de compose (uvicorn local, Vercel): IMAGE_STORAGE=memoria (solo desarrollo) o s3 con su endpoint.
# IMAGE_STORAGE=s3
# STORAGE_ENDPOINT=https://<cuenta>.r2.cloudflarestorage.com
# path | virtual | auto (por omisión: path si hay endpoint propio)
# STORAGE_ESTILO_DIRECCION=path
# Consola web de MinIO (solo desde el propio servidor): http://localhost:9001
PUERTO_CONSOLA_MINIO=9001

# --- Correo -------------------------------------------------------------------------------------------
# consola: los correos se escriben en el registro (solo desarrollo sin compose) | smtp: se envían.
EMAIL_SENDER=smtp
# dev: Mailpit (sin cifrado). Ver los correos en http://localhost:8025
# [PROD] smtp.unas.edu.pe
SMTP_HOST=mailpit
# [PROD] 587 (o 465 con ssl)
SMTP_PORT=1025
# [PROD] starttls | ssl
SMTP_TLS=ninguno
# [PROD] usuario del buzón
SMTP_USER=
# [PROD] contraseña
SMTP_PASSWORD=
# [PROD] La Banca <no-responder@unas.edu.pe>
SMTP_FROM="La Banca <no-responder@localhost>"
PUERTO_MAILPIT=8025

# --- Parámetros del sistema (SRS §3.2; un valor fuera de rango se ignora, RF-CFG-09) ------------------
DOMINIO_INSTITUCIONAL=unas.edu.pe
# 1–10            (RF-CFG-03)
CFG_MAX_PUBLICACIONES_ACTIVAS=3
# 1–60 min        (RF-CFG-05)
CFG_ANTICIPACION_AVISO_CHAT_MIN=10
# 1–30 días       (RF-CFG-06)
CFG_DIAS_RETENCION_REPORTES=7
# 1–72 h          (RF-CFG-07)
CFG_HORAS_INACTIVIDAD_SESION=12

# --- Términos de uso y política de privacidad (RN-31) ------------------------------------------------
# Obligatorios en producción. La versión 2.0 de la app cambió la política (perfil, imágenes, documentos,
# «visto»): publica una versión nueva para que todos la acepten de nuevo.
# [PROD] 2.0
TERMINOS_VERSION=2.0-borrador
# [PROD] fecha de publicación
TERMINOS_FECHA=2026-11-10
# Canal oficial para ejercer los derechos ARCO (Ley N.° 29733): correo o URL de la institución.
# [PROD] obligatorio
CANAL_ARCO=

# --- Automatismos (EA-03, EA-05, EA-07) ---------------------------------------------------------------
# Secreto que el servicio «tareas» (o Vercel Cron) envía como «Authorization: Bearer <CRON_SECRET>».
# Genera uno largo, p. ej.:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# CAMBIAR
CRON_SECRET=CambiaEsteSecretoLargo
# Cada cuántos segundos se ejecutan (3600 = cada hora).
INTERVALO_TAREAS=3600

# --- Acceso sin abrir puertos (opcional) --------------------------------------------------------------
# Cloudflare Tunnel: token del túnel (Zero Trust → Networks → Tunnels). Requiere COMPOSE_PROFILES=…,tunel.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Imágenes de contenedor (opcional) ----------------------------------------------------------------
# MONGO_IMAGEN=mongo:7
# MINIO_IMAGEN=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
