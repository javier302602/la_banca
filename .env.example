# ============================================================================
# La Banca — variables de entorno (copiar a .env o configurarlas en Vercel)
# ============================================================================

# --- Entorno: desarrollo | produccion ---
# En produccion la app no arranca con IMAGE_STORAGE=memoria ni EMAIL_SENDER=consola.
ENTORNO=desarrollo

# --- Base de datos (MongoDB Atlas o replica set local: se usan transacciones) ---
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGO_DB=la_banca_db

# --- Parámetros del sistema (SRS v1.9 §3.2; fuera de rango se ignoran, RF-CFG-09) ---
# TODO: el SRS deja el dominio «PENDIENTE DE DECISIÓN»; unas.edu.pe es el ejemplo del SRS/Entregable 2.
DOMINIO_INSTITUCIONAL=unas.edu.pe
CFG_MAX_PUBLICACIONES_ACTIVAS=3          # 1–10            (RF-CFG-03)
CFG_ANTICIPACION_AVISO_CHAT_MIN=10       # 1–60 min        (RF-CFG-05)
CFG_DIAS_RETENCION_REPORTES=7            # 1–30 días       (RF-CFG-06)
CFG_HORAS_INACTIVIDAD_SESION=12          # 1–72 h          (RF-CFG-07)

# --- Términos de uso y política de privacidad (RF-AUT-17/18) ---
# TODO: versión, fecha y texto legal no están en los documentos del repo.
TERMINOS_VERSION=
TERMINOS_FECHA=
# Canal oficial para ejercer los derechos ARCO (Ley N.° 29733), p. ej. un correo o una URL de la institución.
# Obligatorio con ENTORNO=produccion, igual que TERMINOS_VERSION y TERMINOS_FECHA (RN-31, RNF-LEG-03).
CANAL_ARCO=

# --- URL pública para los enlaces de activación y recuperación ---
# TODO: dominio de despliegue definitivo.
APP_BASE_URL=http://localhost:8000

# --- Cookie de sesión (Secure obligatoria en producción; false solo para http en local) ---
COOKIE_SECURE=true

# --- Almacenamiento de imágenes: memoria (desarrollo) | s3 (Object Storage compatible con S3) ---
# TODO: proveedor de Object Storage no definido en los documentos (S3, R2, MinIO…).
IMAGE_STORAGE=memoria
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Correo: consola (desarrollo) | smtp ---
# TODO: servidor SMTP y remitente institucional no definidos en los documentos.
EMAIL_SENDER=consola
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Vercel Cron: secreto que Vercel envía como «Authorization: Bearer <CRON_SECRET>» ---
CRON_SECRET=
